{
  "name": "hand-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hand Surgery Trainer — installable PWA for learning hand surgery in dead-space moments",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "validate": "node scripts/validate-questions.mjs public/bank/questions.json",
    "deploy": "bash scripts/deploy.sh",
    "deploy:pages": "bash scripts/deploy-pages.sh"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "ts-fsrs": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
